<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baat Pakki Announcement - Fatima & Subhan</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Noto+Nastaliq+Urdu:wght@400;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        :root {
            --card-front-bg: linear-gradient(145deg, #2a0e44, #130520);
            --card-back-bg: #fffdfa;
            --primary-purple: #4a1259;
            --accent-purple: #7c3aed;
            --border-purple: #c084fc;
            --text-dark: #2a1033;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(135deg, #160826, #06020c);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: 'Noto Nastaliq Urdu', 'Amiri', serif;
            padding: 15px;
            overflow-x: hidden;
        }

        .hint-text {
            color: #e9d5ff;
            font-size: 14px;
            margin-bottom: 20px;
            letter-spacing: 1.5px;
            text-align: center;
            animation: pulse 2s infinite;
            font-family: 'Playfair Display', serif;
            direction: ltr;
            text-transform: uppercase;
        }

        /* 3D Card Container */
        .card-container {
            width: 100%;
            max-width: 480px;
            height: 700px;
            position: relative;
            cursor: pointer;
            perspective: 1500px;
        }

        .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-container.open .card-inner {
            transform: rotateY(180deg);
        }

        /* Card Face Base */
        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            border: 2px solid var(--border-purple);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 35px rgba(192, 132, 252, 0.25);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow: hidden;
        }

        /* ---------------- FRONT PAGE (COVER) ---------------- */
        .card-front {
            background: var(--card-front-bg);
            z-index: 2;
        }

        .cover-frame {
            border: 2px solid rgba(212, 175, 55, 0.5);
            border-radius: 14px;
            width: 100%;
            height: 100%;
            padding: 35px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: radial-gradient(circle, rgba(192, 132, 252, 0.12) 0%, transparent 75%);
            position: relative;
        }

        .cover-ayat {
            font-family: 'Amiri', serif;
            font-size: 36px;
            color: #f8f0ff;
            line-height: 1.8;
            margin-bottom: 25px;
            text-shadow: 0 0 15px rgba(192, 132, 252, 0.5);
            font-weight: 700;
        }

        .cover-translation {
            font-family: 'Playfair Display', serif;
            font-size: 16px;
            color: #d8b4fe;
            letter-spacing: 1px;
            direction: ltr;
        }

        .tap-badge {
            margin-top: 50px;
            background: rgba(192, 132, 252, 0.15);
            border: 1px solid var(--border-purple);
            color: #f3e8ff;
            padding: 10px 28px;
            border-radius: 25px;
            font-size: 13px;
            font-family: 'Cinzel', serif;
            direction: ltr;
            letter-spacing: 2px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }

        /* ---------------- BACK PAGE (INSIDE INVITATION) ---------------- */
        .card-back {
            background: var(--card-back-bg);
            transform: rotateY(180deg);
        }

        .inner-frame {
            border: 1.5px solid #d8b4fe;
            border-radius: 14px;
            width: 100%;
            height: 100%;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            text-align: center;
            background: radial-gradient(circle at center, rgba(255,255,255,1) 60%, rgba(245,235,255,0.5) 100%);
            position: relative;
        }

        /* Bismillah Section */
        .bismillah-block {
            width: 100%;
            margin-top: 10px;
        }

        .bismillah-arabic {
            font-family: 'Amiri', serif;
            font-size: 28px;
            color: var(--primary-purple);
            font-weight: 700;
            line-height: 1.8;
            margin-bottom: 4px;
        }

        .bismillah-translation {
            font-size: 12px;
            color: #6b4683;
            line-height: 1.8;
            border-bottom: 1px solid #f0e2ff;
            padding-bottom: 10px;
        }

        /* Title */
        .title-block {
            margin: 5px 0;
        }

        .main-title {
            font-size: 32px;
            color: var(--primary-purple);
            font-weight: 700;
            line-height: 2.2;
        }

        .sub-title {
            font-family: 'Cinzel', serif;
            font-size: 10px;
            letter-spacing: 3px;
            color: var(--accent-purple);
            text-transform: uppercase;
            direction: ltr;
        }

        /* Couple Names Section */
        .couple-names {
            background: linear-gradient(135deg, rgba(192, 132, 252, 0.12), rgba(243, 232, 255, 0.6));
            padding: 12px 25px;
            border-radius: 14px;
            border: 1px dashed var(--border-purple);
            width: 90%;
            margin: 10px 0;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
        }

        .name {
            font-size: 30px;
            color: var(--primary-purple);
            font-weight: 700;
            line-height: 1.6;
        }

        .and-symbol {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            color: var(--accent-purple);
            font-style: italic;
            direction: ltr;
        }

        /* Dua Text Lines */
        .invitation-text {
            font-size: 13.5px;
            line-height: 2.8;
            color: var(--text-dark);
            margin: 8px 0;
            padding: 0 10px;
        }

        .dua-arabic {
            font-family: 'Amiri', serif;
            font-size: 20px;
            color: var(--primary-purple);
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
        }

        /* Date Section */
        .date-box {
            border-top: 1px solid #f0e2ff;
            border-bottom: 1px solid #f0e2ff;
            padding: 10px 0;
            line-height: 2.4;
            font-size: 14px;
            color: var(--text-dark);
            width: 100%;
            margin-bottom: 10px;
        }

        .date-box span {
            color: var(--primary-purple);
            font-weight: 700;
        }

        /* PURE VECTOR SVG FLORAL CORNERS */
        .flower-svg {
            position: absolute;
            width: 90px;
            height: 90px;
            pointer-events: none;
            z-index: 10;
        }

        .flower-tl { top: 4px; left: 4px; }
        .flower-tr { top: 4px; right: 4px; transform: scaleX(-1); }
        .flower-bl { bottom: 4px; left: 4px; transform: scaleY(-1); }
        .flower-br { bottom: 4px; right: 4px; transform: scale(-1); }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.75; transform: scale(0.98); }
        }

        @media (max-width: 480px) {
            .card-container { height: 680px; }
            .cover-ayat { font-size: 30px; }
            .bismillah-arabic { font-size: 24px; }
            .main-title { font-size: 28px; }
            .name { font-size: 26px; }
            .invitation-text { font-size: 12.5px; line-height: 2.6; }
            .flower-svg { width: 75px; height: 75px; }
        }
    </style>
</head>
<body>

    <div class="hint-text" id="hintText">✨ Click Card To Open Invitation ✨</div>

    <div class="card-container" id="cardContainer">
        <div class="card-inner">
            
            <!-- COVER PAGE (Outside) -->
            <div class="card-face card-front">
                
                <svg class="flower-svg flower-tl" viewBox="0 0 100 100">
                    <path d="M 0 0 L 0 40 Q 20 20 40 0 Z" fill="#d4af37" opacity="0.3"/>
                    <circle cx="25" cy="25" r="12" fill="#c084fc"/>
                    <circle cx="15" cy="40" r="8" fill="#e9d5ff"/>
                    <circle cx="40" cy="15" r="8" fill="#e9d5ff"/>
                    <path d="M 5 60 C 20 50, 50 20, 60 5" stroke="#d4af37" stroke-width="2" fill="none"/>
                    <circle cx="5" cy="5" r="5" fill="#d4af37"/>
                </svg>
                <svg class="flower-svg flower-tr" viewBox="0 0 100 100">
                    <path d="M 0 0 L 0 40 Q 20 20 40 0 Z" fill="#d4af37" opacity="0.3"/>
                    <circle cx="25" cy="25" r="12" fill="#c084fc"/>
                    <circle cx="15" cy="40" r="8" fill="#e9d5ff"/>
                    <circle cx="40" cy="15" r="8" fill="#e9d5ff"/>
                    <path d="M 5 60 C 20 50, 50 20, 60 5" stroke="#d4af37" stroke-width="2" fill="none"/>
                    <circle cx="5" cy="5" r="5" fill="#d4af37"/>
                </svg>
                <svg class="flower-svg flower-bl" viewBox="0 0 100 100">
                    <circle cx="25" cy="25" r="12" fill="#c084fc"/>
                    <circle cx="15" cy="40" r="8" fill="#e9d5ff"/>
                    <circle cx="40" cy="15" r="8" fill="#e9d5ff"/>
                </svg>
                <svg class="flower-svg flower-br" viewBox="0 0 100 100">
                    <circle cx="25" cy="25" r="12" fill="#c084fc"/>
                    <circle cx="15" cy="40" r="8" fill="#e9d5ff"/>
                    <circle cx="40" cy="15" r="8" fill="#e9d5ff"/>
                </svg>

                <div class="cover-frame">
                    <div class="cover-ayat">وَخَلَقْنَاكُمْ أَزْوَاجًا</div>
                    <div class="cover-translation">And We created you in pairs</div>
                    <div class="tap-badge">OPEN INVITATION</div>
                </div>
            </div>

            <!-- INVITATION DETAILS PAGE (Inside) -->
            <div class="card-face card-back">
                
                <svg class="flower-svg flower-tl" viewBox="0 0 100 100">
                    <path d="M 10 80 Q 20 30 80 10" stroke="#c084fc" stroke-width="2" fill="none"/>
                    <circle cx="28" cy="28" r="14" fill="#9333ea"/>
                    <circle cx="28" cy="28" r="7" fill="#f3e8ff"/>
                    <circle cx="14" cy="44" r="9" fill="#c084fc"/>
                    <circle cx="44" cy="14" r="9" fill="#c084fc"/>
                </svg>
                <svg class="flower-svg flower-tr" viewBox="0 0 100 100">
                    <path d="M 10 80 Q 20 30 80 10" stroke="#c084fc" stroke-width="2" fill="none"/>
                    <circle cx="28" cy="28" r="14" fill="#9333ea"/>
                    <circle cx="28" cy="28" r="7" fill="#f3e8ff"/>
                    <circle cx="14" cy="44" r="9" fill="#c084fc"/>
                    <circle cx="44" cy="14" r="9" fill="#c084fc"/>
                </svg>
                <svg class="flower-svg flower-bl" viewBox="0 0 100 100">
                    <path d="M 10 80 Q 20 30 80 10" stroke="#c084fc" stroke-width="2" fill="none"/>
                    <circle cx="28" cy="28" r="14" fill="#9333ea"/>
                    <circle cx="28" cy="28" r="7" fill="#f3e8ff"/>
                    <circle cx="14" cy="44" r="9" fill="#c084fc"/>
                    <circle cx="44" cy="14" r="9" fill="#c084fc"/>
                </svg>
                <svg class="flower-svg flower-br" viewBox="0 0 100 100">
                    <path d="M 10 80 Q 20 30 80 10" stroke="#c084fc" stroke-width="2" fill="none"/>
                    <circle cx="28" cy="28" r="14" fill="#9333ea"/>
                    <circle cx="28" cy="28" r="7" fill="#f3e8ff"/>
                    <circle cx="14" cy="44" r="9" fill="#c084fc"/>
                    <circle cx="44" cy="14" r="9" fill="#c084fc"/>
                </svg>

                <div class="inner-frame">
                    
                    <!-- Bismillah -->
                    <div class="bismillah-block">
                        <div class="bismillah-arabic">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>
                        <div class="bismillah-translation">شروع اللہ کے نام سے جو بڑا مہربان، نہایت رحم کرنے والا ہے</div>
                    </div>

                    <!-- Main Title: Baat Pakki -->
                    <div class="title-block">
                        <div class="main-title">بات پکی</div>
                        <div class="sub-title">Baat Pakki Announcement</div>
                    </div>

                    <!-- Couple Names directly below title -->
                    <div class="couple-names">
                        <div class="name">فاطمہ</div>
                        <div class="and-symbol">&</div>
                        <div class="name">سبحان</div>
                    </div>

                    <!-- Dua Lines -->
                    <div class="invitation-text">
                        <span class="dua-arabic">بَارَكَ اللَّهُ لَكُمَا وَبَارَكَ عَلَيْكُمَا</span>
                        اللہ تعالیٰ اس نئے سفر میں برکت، محبت اور خوشیاں عطا فرمائے۔<br>
                        آپ تمام احباب سے خلوصِ دل سے دعاؤں کی درخواست ہے۔
                    </div>

                    <!-- Date Only -->
                    <div class="date-box">
                        <div><span>تاریخ:</span> 12 ستمبر 2026ء (بروز ہفتہ)</div>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script>
        const cardContainer = document.getElementById('cardContainer');
        const hintText = document.getElementById('hintText');

        cardContainer.addEventListener('click', () => {
            cardContainer.classList.toggle('open');
            
            if (cardContainer.classList.contains('open')) {
                hintText.innerText = "✨ Fatima & Subhan's Baat Pakki ✨";
                
                setTimeout(() => {
                    confetti({
                        particleCount: 100,
                        spread: 85,
                        origin: { y: 0.55 },
                        colors: ['#a855f7', '#c084fc', '#7e22ce', '#d4af37', '#ffffff']
                    });
                }, 350);
            } else {
                hintText.innerText = "✨ Click Card To Open Invitation ✨";
            }
        });
    </script>
</body>
</html>